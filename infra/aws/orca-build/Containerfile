# Builds `orca serve` (the Electron main process / IDE backend) from CoDev's own
# first-party IDE source in packages/ide, which is this image's build context.
# See infra/aws/scripts/build-orca-serve.sh, which builds the image with Apple's
# `container` tool and copies the resulting artifact out.
#
# There is no upstream clone and no patch step any more: the IDE is forked into
# this monorepo (see packages/ide/README.md), so what builds here is exactly the
# source in the tree — the same source `pnpm orca:web` builds the browser client
# from, which is what keeps the two halves on one version by construction.
FROM ubuntu:24.04

ARG TARGET_ARCH=arm64
ARG ARTIFACT_ARCH=arm64
ENV DEBIAN_FRONTEND=noninteractive

# The last group (libgtk-3-0t64 and below) is not needed to *run* orca serve
# (the packaged AppImage bundles its own copies), but electron-builder spawns
# the freshly-unpacked, not-yet-bundled node_modules/electron binary during
# this build itself (native module rebuild, icon generation) and that needs
# the same shared libraries a desktop Chromium/Electron runtime needs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git python3 build-essential fakeroot rpm squashfs-tools xz-utils unzip \
      libgtk-3-0t64 libnss3 libnspr4 libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 \
      libcups2t64 libdrm2 libgbm1 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
      libxrandr2 libxshmfence1 libxss1 libxtst6 libpango-1.0-0 libpangocairo-1.0-0 \
      libcairo2 libglib2.0-0t64 libdbus-1-3 fonts-liberation xdg-utils zlib1g-dev \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && corepack enable \
    && corepack prepare pnpm@10.24.0 --activate \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# The build context is packages/ide (set by build-orca-serve.sh). Its
# .dockerignore keeps node_modules/, out/, and dist/ out of the transfer, so a
# developer's local IDE install never leaks into the image.
COPY . /build

RUN pnpm install --frozen-lockfile

# ORCA_LINUX_ARM64_RELEASE controls electron-builder's ARM artifact naming.
# TARGET_ARCH is either arm64 or x64 and matches the architecture of the
# build container so the resulting AppImage can be extracted below.
RUN if [ "${TARGET_ARCH}" = arm64 ]; then export ORCA_LINUX_ARM64_RELEASE=1; fi; \
    pnpm run build:linux -- --"${TARGET_ARCH}"

# `orca serve` is what the orchestrator (services/orchestrator/src/backend/orca.rs)
# spawns per workspace. `--appimage-extract` unpacks the AppImage into a plain
# squashfs-root/ directory with no FUSE mount required, which is exactly the
# layout production already runs `AppRun` out of, so the orchestrator needs no
# AppImage-specific runtime handling on the host. Extract the appended
# SquashFS directly instead of executing the AppImage's static ELF launcher;
# the latter cannot run under Apple Container's cross-architecture emulation.
RUN set -eu; \
    appimage="$(find dist -maxdepth 1 -name '*.AppImage' -print -quit)"; \
    test -n "${appimage}"; \
    squashfs_offset=""; \
    for candidate in $(grep -aob 'hsqs' "${appimage}" | cut -d: -f1); do \
      if unsquashfs -s -o "${candidate}" "${appimage}" >/dev/null 2>&1; then \
        squashfs_offset="${candidate}"; \
        break; \
      fi; \
    done; \
    test -n "${squashfs_offset}"; \
    unsquashfs -no-progress -o "${squashfs_offset}" -d dist/squashfs-root "${appimage}" >/dev/null; \
    archive="dist/orca-serve-linux-${ARTIFACT_ARCH}.tar.gz"; \
    tar -C dist -czf "${archive}" squashfs-root; \
    sha256sum "${archive}" | awk '{print $1}' > "${archive}.sha256"
