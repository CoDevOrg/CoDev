+      unifiedTabsByWorktree: {},
+      closeTab,
+    })
+
+    launchCodevDefaultChatTab({ worktreeId: 'wt-1' })
+    vi.advanceTimersByTime(30_000)
+
+    expect(closeTab).not.toHaveBeenCalled()
+  })
