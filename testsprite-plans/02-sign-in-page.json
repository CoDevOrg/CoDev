{
  "$schema": "https://raw.githubusercontent.com/TestSprite/testsprite-cli/v0.5.0/schemas/plan.schema.json",
  "projectId": "728c7e85-4f91-4fc7-969b-0c962adb7c2e",
  "type": "frontend",
  "name": "Sign-in — Welcome card shows credentials and OAuth options",
  "planSteps": [
    {
      "type": "action",
      "description": "Navigate to https://codev-xi.vercel.app/sign-in"
    },
    {
      "type": "assertion",
      "description": "A heading with the exact text 'Welcome to CoDev.' is visible"
    },
    {
      "type": "assertion",
      "description": "An input labeled 'Name' is visible"
    },
    {
      "type": "assertion",
      "description": "An input labeled 'Email' is visible"
    },
    {
      "type": "assertion",
      "description": "An input labeled 'Password' is visible"
    },
    {
      "type": "assertion",
      "description": "A button labeled 'Continue with Google' is visible"
    },
    {
      "type": "action",
      "description": "Click the 'Back' link in the auth navigation"
    },
    {
      "type": "assertion",
      "description": "The browser URL path is / and the CoDev wordmark or brand text is visible"
    }
  ]
}
