# Supabase on Vercel provides these automatically. POSTGRES_URL is pooled for
# Vercel Functions; POSTGRES_URL_NON_POOLING is used by migration tooling.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for Phase 5 realtime coordination.
REDIS_URL=

# Phase 2 GitHub App authorization. Generate AUTH_SECRET with `pnpm auth:secret`
# and CREDENTIAL_ENCRYPTION_KEY with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_APP_SLUG=
CREDENTIAL_ENCRYPTION_KEY=

# Reserved for Phase 3 Vercel-to-AWS orchestration.
AWS_REGION=
ORCHESTRATOR_URL=
