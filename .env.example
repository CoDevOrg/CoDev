# Supabase on Vercel provides these automatically. POSTGRES_URL is pooled for
# Vercel Functions; POSTGRES_URL_NON_POOLING is used by migration tooling.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Redis backs room streams and workspace coordination.
REDIS_URL=

# Phase 2 GitHub App authorization. Generate AUTH_SECRET with `pnpm auth:secret`
# and CREDENTIAL_ENCRYPTION_KEY with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth callback: /api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Transactional From address (Resend). Defaults to CoDev <noreply@trycodev.com>.
AUTH_EMAIL_FROM=
# Waitlist pings go here. Use the ImprovMX alias, e.g. yousef@trycodev.com.
ACCESS_REQUEST_NOTIFY_EMAIL=
# Registration is hard-closed. This legacy setting is intentionally ignored.
SIGNUP_ALLOWLIST=
GITHUB_APP_SLUG=
# Fine-grained or classic PAT with issues:write on the CoDev product repo.
# Used by the floating feedback widget to open GitHub issues automatically.
FEEDBACK_GITHUB_TOKEN=
# Optional override; defaults to VERCEL_GIT_REPO_OWNER/SLUG or yousef20920/CoDev.
FEEDBACK_GITHUB_REPO=
CREDENTIAL_ENCRYPTION_KEY=
# Required in production. The Key Vault key identifier that wraps each stored
# credential's data key. Without it, production refuses to store credentials
# rather than falling back to the development envelope above.
CREDENTIAL_KEY_VAULT_KEY_ID=

# Optional subscription OAuth overrides for Claude Code and Codex.
# Defaults use the public Claude Code / Codex CLI PKCE clients:
# Claude = paste-code via Anthropic's callback page
# Codex = ChatGPT device-code sign-in
# Set *_OAUTH_REDIRECT_URI to switch a provider into app-callback mode with
# /api/auth/oauth/claude/callback or /api/auth/oauth/codex/callback.
CLAUDE_OAUTH_CLIENT_ID=
CLAUDE_OAUTH_CLIENT_SECRET=
CLAUDE_OAUTH_AUTHORIZE_URL=
CLAUDE_OAUTH_TOKEN_URL=
CLAUDE_OAUTH_REDIRECT_URI=
CLAUDE_OAUTH_SCOPE=
CODEX_OAUTH_CLIENT_ID=
CODEX_OAUTH_CLIENT_SECRET=
CODEX_OAUTH_AUTHORIZE_URL=
CODEX_OAUTH_TOKEN_URL=
CODEX_OAUTH_REDIRECT_URI=
CODEX_OAUTH_SCOPE=

# In-app "Connect Claude" flow (hosted `claude setup-token` runner).
# Unset: the button is hidden and the session routes return 503 — the
# settings card falls back to API key + CoDev CLI instructions.
#
# "orchestrator" — the deployed path, and the only one Vercel can use. Runs
# `claude setup-token` inside a throwaway Firecracker sandbox on the runtime
# host, over ORCHESTRATOR_DIRECT_URL/ORCHESTRATOR_DIRECT_SECRET.
# Requires a runtime host deployed from a revision whose bootstrap-host.sh
# installs /usr/local/bin/claude into the guest rootfs and whose orchestrator
# serves /v1/sandboxes/{id}/claude-auth-login; see infra/runtime/deploy.sh.
#
# "subprocess" — spawns the official Claude Code binary on this host instead.
# Only works where the `claude` binary is on PATH, the runtime can spawn
# long-lived child processes, and there is a single instance (local dev or a
# dedicated worker — NOT Vercel serverless).
CLAUDE_CONNECTION_RUNNER=
# The options below apply to the "subprocess" runner only; the
# "orchestrator" runner invokes claude inside the sandbox and ignores them.
# Optional: pin the official executable's absolute path (default "claude").
CLAUDE_CONNECTION_RUNNER_COMMAND=
# Persistent local profile root, outside repositories; default ~/.codev/claude-profiles.
# The CLI owns credentials here. CoDev stores only a versioned connection reference.
CODEV_CLAUDE_PROFILE_ROOT=

# OpenAI model used for agent runs and AI-generated pull request summaries.
# Defaults to gpt-5 when omitted.
CODEV_OPENAI_MODEL=

# Vercel-to-Azure orchestration. There is deliberately no client secret:
# AZURE_CLIENT_ID plus AZURE_TENANT_ID selects workload identity federation,
# where Vercel's own OIDC token is the assertion. Never add an Azure client
# secret to Vercel. The Cloudflare Worker uses a separate app registration
# (AZURE_CLIENT_SECRET) that can unwrap Key Vault keys and operate the host VM.
#
# LOCAL DEVELOPMENT: leave AZURE_TENANT_ID and AZURE_CLIENT_ID EMPTY. Setting
# them selects the Vercel OIDC exchange, which cannot work off Vercel. Empty,
# apps/web falls back to DefaultAzureCredential, so `az login` is the whole
# setup -- there is no local runtime to run, you connect to the real VMs.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
# Optional. Unset resolves the host through the stack's tags, which is what
# lets a replaced host be picked up without redeploying apps/web.
AZURE_HOST_VM_NAME=
# Optional rollout flag. When true, the configured host is enrolled in the
# durable scheduler on first workspace wake; additional hosts can be registered
# through the runtime host pool controller.
CODEV_RUNTIME_HOST_POOL_ENABLED=false
# Phase 5 canary. When enabled, Firecracker workspace disks are kept on
# per-workspace Azure managed disks and attached exclusively to the assigned
# host. Leave false until the post-merge persistence canary passes.
CODEV_WORKSPACE_PERSISTENT_STORAGE_ENABLED=false
# Required when persistent workspace storage is enabled; must match the Azure
# runtime resource group's region.
AZURE_RUNTIME_LOCATION=
# Optional; defaults to 64 GiB when persistent storage is enabled.
CODEV_WORKSPACE_DISK_SIZE_GIB=64

# The orchestrator. This bearer-authenticated endpoint is the only path to the
# host, so both are required, locally too. ("Direct" is historical: it began as
# a bypass around the API Gateway proxy that once fronted the EC2 host.)
ORCHESTRATOR_DIRECT_URL=
ORCHESTRATOR_DIRECT_SECRET=

# Region for Amazon Bedrock, which members can bring as their own model
# provider. This is the only AWS variable left and has nothing to do with the
# runtime, which is entirely on Azure.
AWS_REGION=us-east-2

# Authenticates the Gen 2 compute quota reconciliation route and Worker cron.
CRON_SECRET=

# ARM workspaces use a separate Azure identity and resource group from Firecracker.
# Tenant and subscription use AZURE_TENANT_ID and AZURE_SUBSCRIPTION_ID.
ARM_WORKSPACE_AZURE_CLIENT_ID=
ARM_WORKSPACE_AZURE_CLIENT_SECRET=
ARM_WORKSPACE_RESOURCE_GROUP=
ARM_WORKSPACE_IMAGE_VERSION_ID=
ARM_WORKSPACE_SSH_PUBLIC_KEY=
ARM_WORKSPACE_SIGNING_PRIVATE_KEY=
ARM_WORKSPACE_SIGNING_PUBLIC_KEY=
# Runtime token: Tunnel Write on the account and DNS Write on trycodev.com only.
CLOUDFLARE_API_TOKEN=

# Free ARM entitlement rollout (disabled until UI and release gates are complete).
GEN2_FREE_ARM_ENABLED=false
# Optional comma-separated owner UUIDs; empty enables all owners when the flag is true.
GEN2_FREE_ARM_OWNER_IDS=
