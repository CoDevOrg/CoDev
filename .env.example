# Supabase on Vercel provides these automatically. POSTGRES_URL is pooled for
# Vercel Functions; POSTGRES_URL_NON_POOLING is used by migration tooling.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clerk controls Google and GitHub SSO in the hosted website.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional OpenFGA fine-grained workspace authorization.
OPENFGA_API_URL=
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
OPENFGA_CLIENT_TOKEN=

# Reserved for Phase 5 realtime coordination.
REDIS_URL=

# Hocuspocus/Yjs realtime collaboration. The token secret must be shared by
# the Vercel web app and the standalone Hocuspocus service.
HOCUSPOCUS_TOKEN_SECRET=
NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:8787

# Phase 2 GitHub App authorization. Generate AUTH_SECRET with `pnpm auth:secret`
# and CREDENTIAL_ENCRYPTION_KEY with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth callback: /api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GITHUB_APP_SLUG=
CREDENTIAL_ENCRYPTION_KEY=
# Required in production for AWS KMS-backed GitHub token storage.
CREDENTIAL_KMS_KEY_ID=

# OpenAI model used for agent runs and AI-generated pull request summaries.
# Defaults to gpt-5 when omitted.
CODEV_OPENAI_MODEL=

# Phase 3 Vercel-to-AWS orchestration. AWS_ROLE_ARN is assumed with the
# short-lived Vercel OIDC token; never add an AWS access key to Vercel.
AWS_REGION=us-east-2
AWS_ROLE_ARN=
AWS_HOST_INSTANCE_ID=
ORCHESTRATOR_URL=

# Authenticates Vercel's Phase 8 lifecycle reconciler.
CRON_SECRET=

# Phase 10 closed-beta operator allowlist. Use GitHub logins, separated by
# commas. This is evaluated server-side and is never exposed to the browser.
PILOT_ADMIN_GITHUB_LOGINS=
